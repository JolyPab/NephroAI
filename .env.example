# Root Docker Compose env for production-like runs.
# Do not commit real production values. Production uses /root/medic/.env on the server.

POSTGRES_USER=medic_app
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_DB=medic

JWT_SECRET=change-me-use-at-least-32-random-bytes
SECRET_KEY=
# Comma-separated accounts allowed to open /admin.
ADMIN_EMAILS=owner@example.com
FERNET_KEY=change-me-generate-with-cryptography-fernet
OPENAI_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_REQUIRE_DELIVERY=true
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_FORWARD_TO=
RESEND_INBOUND_FORWARD_FROM=
RESEND_INBOUND_FORWARD_ATTACHMENTS=true

LIVEKIT_URL=wss://app.nephroai.ec/livekit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=209.50.54.90

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_PUBLIC_URL=https://app.nephroai.ec

CORS_ORIGINS=https://app.nephroai.ec,https://app.nephroai.mx
ENV=production
REQUIRE_REDIS_HEALTH=true

BACKUP_ENCRYPTION_KEY=change-me-store-outside-git
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=/root/medic/backups
